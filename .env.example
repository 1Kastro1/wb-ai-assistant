# Runtime data stays OUTSIDE this source directory and OneDrive.
# Default: %LOCALAPPDATA%/WBAIAssistant/data
# WB_DATA_DIR=C:/Users/your-user/AppData/Local/WBAIAssistant/data
# Public address served by Cloudflare Tunnel (optional):
# WB_PUBLIC_ORIGIN=https://assistant.example.com
OLLAMA_MODEL=qwen3:4b
# Для командного сервера используйте PostgreSQL. Локальная установка без этой строки продолжит работать на SQLite.
# DATABASE_URL=postgresql+psycopg://wb_assistant:change-me@127.0.0.1:5432/wb_assistant
# Docker Compose также требует POSTGRES_PASSWORD в локальном .env.
# POSTGRES_PASSWORD=change-me-long-random-password
# LOCAL_ONLY and CLOUD_AI=false are enforced by backend.
# SAFE_MODE=false and TEST_MODE=true are initial persisted defaults.
# Do not put WB tokens or passwords in this file.
# Enable only after separately authorizing real publication:
# WB_ENABLE_REAL_PUBLISH=I_EXPLICITLY_AUTHORIZE_REAL_PUBLISH
